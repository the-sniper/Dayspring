# Anthropic API key — used for match scoring, paste-parsing, and role
# classification only. The tracker and job feed work without it.
ANTHROPIC_API_KEY=

# Apollo master API key — contact search (free) + email enrichment (1 credit
# per reveal). Contact finder stays off without it.
APOLLO_API_KEY=

# Happenstance API key (hpn_…) — natural-language search over YOUR OWN network
# (2 credits/search) + deep person research (1 credit). Free tier available at
# happenstance.ai. Warm-network features stay off without it.
HAPPENSTANCE_API_KEY=

# Google OAuth Desktop-app client — Gmail send + reply detection + emailed
# digest. Create in Google Cloud Console (enable Gmail API, consent screen in
# testing mode with yourself as test user), then run `npm run gmail:auth` once.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Credential vault encryption passphrase (M18+). Encrypts job-site passwords
# at rest with AES-256-GCM. Pick any strong passphrase — NEVER commit it.
# Apply-assist's credential vault stays off without it.
DAYSPRING_VAULT_KEY=

# Optional: override the SQLite file location (default: data/dayspring.db)
# DAYSPRING_DB_PATH=
