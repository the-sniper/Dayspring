# Convex — the database. Run `npx convex dev` once to create a deployment; it
# writes CONVEX_DEPLOYMENT + NEXT_PUBLIC_CONVEX_URL here automatically. The URL
# is read by the web app (RSC + reactive client) and by the CLI/MCP scripts.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Convex Auth — Google sign-in (set on the Convex deployment dashboard, not here).
# Create a "Web application" OAuth client in Google Cloud Console and add:
#   redirect URI: https://<your-deployment>.convex.site/api/auth/callback/google
#   JS origin:    https://your-vercel-app.vercel.app  (or http://localhost:3000)
# Also set SITE_URL on the Convex deployment to where the Next.js app is hosted
# (http://localhost:3000 for local dev, your Vercel URL for prod). OAuth redirects
# back to SITE_URL after Google — if it still says localhost, prod sign-in breaks.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# CLI scripts (npm run seed, pull-jobs, daily, …) sign in as this user.
# Create the account at /signin first, then paste credentials here.
# DAYSPRING_CLI_EMAIL=
# DAYSPRING_CLI_PASSWORD=

# Anthropic API key — the perfection tier. Tailored resumes, cover letters,
# outreach drafts, PDF fidelity extraction, and the fabrication audit all run on
# Claude. Required for AI features.
# LOCAL DEV ONLY: if set here, unauthenticated CLI scripts can use it. Signed-in
# users (web or hosted) must save their own key in Settings → API Keys.
ANTHROPIC_API_KEY=

# OpenAI API key — the cost tier (optional). When set, the analytical/mechanical
# work (job scoring, resume↔JD match scoring, contact ranking, role
# classification, query + skill parsing) AND the outbound prose (cover letters,
# outreach drafts, follow-up nudges) run on GPT-5.6 instead of Claude to cut
# spend. Everything gracefully falls back to Claude if this is absent.
# LOCAL DEV ONLY: unauthenticated CLI scripts may use env keys. Signed-in users
# must save their own key in Settings → API Keys.
# Optional model overrides:
#   OPENAI_MODEL_STANDARD  scoring/ranking model (default: gpt-5.6-terra)
#   OPENAI_MODEL_CHEAP     extraction/classification model (default: gpt-5.6-luna)
#   OPENAI_MODEL_PREMIUM   cover letters/outreach model (default: gpt-5.6-terra;
#                          set to gpt-5.6-sol for flagship prose quality)
OPENAI_API_KEY=

# Apollo master API key — contact search (free) + email enrichment (1 credit
# per reveal). Contact finder stays off without it.
# LOCAL DEV ONLY — signed-in users save their own key in Settings → API Keys.
APOLLO_API_KEY=

# Happenstance API key (hpn_…) — natural-language search over YOUR OWN network
# (2 credits/search) + deep person research (1 credit). Free tier available at
# happenstance.ai. Warm-network features stay off without it.
# LOCAL DEV ONLY — signed-in users save their own key in Settings → API Keys.
HAPPENSTANCE_API_KEY=

# Google OAuth Desktop-app client — Gmail send + reply detection + emailed
# digest. Create in Google Cloud Console (enable Gmail API, consent screen in
# testing mode with yourself as test user), then run `npm run gmail:auth` once.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vault encryption passphrase (M18+). Encrypts job-site passwords AND every
# API key saved via Settings → API Keys with AES-256-GCM before they are
# stored in Convex (Convex only ever sees ciphertext). Pick any strong
# passphrase — NEVER commit it, and set the SAME value on your hosting
# provider (e.g. Vercel env vars) or saved keys become unreadable there.
DAYSPRING_VAULT_KEY=

# Adzuna aggregator — broad, cross-industry US job coverage for the long tail
# not on a watched ATS board. Free tier: register an app at
# developer.adzuna.com for an app_id + app_key. Aggregator pull stays off
# without both keys; the ATS/catalog pull works regardless.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional aggregator tuning:
#   ADZUNA_QUERIES  comma-separated `what` terms (default: derived from onboarding roleTypes)
#   ADZUNA_MAX_DAYS max posting age in days (default: 15; portal hard-caps at 15)
#   ADZUNA_PAGES    pages (50 results each) per query (default: 2)
# ADZUNA_QUERIES=
# ADZUNA_MAX_DAYS=15
# ADZUNA_PAGES=2

# Apify API token — the feed's second source: LinkedIn posts where people
# announce open roles. LinkedIn has no public post-search API, so this runs
# through a third-party scraping actor (billed per run by Apify, and scraping
# LinkedIn can violate its terms — a deliberate opt-in). The posts feed stays
# empty without a token; the ATS/catalog pull works regardless.
# LOCAL DEV ONLY — signed-in users save their own token in Settings → API Keys.
APIFY_API_TOKEN=
# Optional: swap the actor without a code change (default:
# harvestapi~linkedin-post-search — keyword post search, no LinkedIn cookie or
# account needed). datadoping~linkedin-posts-search-scraper is also supported
# with a purpose-built input payload; any other actor gets a generic keyword
# payload, and the normalizer reads common field aliases for the output.
# LINKEDIN_POSTS_ACTOR=
# Optional posts tuning:
#   LINKEDIN_POSTS_MAX_DAYS  max post age in days (default: 15; portal hard-caps at 15)
#   LINKEDIN_POSTS_PER_QUERY items per search term (default: 25)
# LINKEDIN_POSTS_MAX_DAYS=15
# LINKEDIN_POSTS_PER_QUERY=25

# Shared secret for the hosted daily LinkedIn pull (app/api/cron/linkedin).
# Vercel Cron sends it as `Authorization: Bearer <secret>`; without this set
# the route is disabled. Unrelated to the local `npm run daily` path.
CRON_SECRET=

# Optional: mark this deployment as hosted (Vercel sets VERCEL automatically).
# Hosted mode disables machine-bound features: apply-assist's headed browser
# and the launchd daily agent.
# DAYSPRING_HOSTED=1

# ── Apply-assist browser ─────────────────────────────────────────────────────
# Apply-assist runs a PERSISTENT Chrome profile so account-based boards
# (Workday above all) arrive already signed in. Sign into a tenant once, by
# hand, in that window and every later application to it autofills instead of
# going manual. Default location: data/browser-profile (already gitignored).
# DAYSPRING_BROWSER_PROFILE=

# Optional escape hatch: drive the Chrome you are ALREADY using instead of the
# Dayspring profile. Start Chrome with --remote-debugging-port=9222 and set
# this. Maximum session reuse (LinkedIn included), but automation shares the
# window with you, so a stray click during a fill pass lands in the form.
# Falls back to the persistent profile if the attach fails.
# DAYSPRING_CDP_URL=http://localhost:9222

# ── LaTeX resume rendering ───────────────────────────────────────────────────
# Tailored resumes are .tex, and compiling them to PDF is what makes the length
# check real (the page count comes from the compiler, not a model's guess).
#
# No npm package can do this inside Node without a TeX install, so the default
# is a small compile sidecar you deploy once — see services/latex/README.md.
# With it set, nothing needs installing here or on any user's machine.
DAYSPRING_LATEX_SERVICE_URL=
# Must match LATEX_SERVICE_SECRET on the service.
DAYSPRING_LATEX_SERVICE_SECRET=
#
# Wire protocol for the sidecar. The service speaks all three from one handler
# (Connect), so this is a transport choice, not a code change:
#   connect (default) — Connect over HTTP/1.1. Works from Vercel, through any
#                       proxy, and with curl. Use this unless you have a reason.
#   grpc              — gRPC proper over h2c. Needs DAYSPRING_LATEX_GRPC_URL,
#                       because a Node plaintext http2 server can't also serve
#                       HTTP/1.1, so the sidecar runs gRPC on a second port.
#   grpcweb           — gRPC-Web over HTTP/1.1, for proxies that mangle h2c.
# DAYSPRING_LATEX_PROTOCOL=connect
# DAYSPRING_LATEX_GRPC_URL=http://localhost:8081
#
# Unset the two above and Dayspring falls back to a locally installed engine
# (tectonic / pdflatex / xelatex / lualatex), searching $PATH plus the usual
# macOS TeX locations. That only ever helps your own machine.
# Point this at a binary if your TeX install is somewhere unusual:
# DAYSPRING_TEX_ENGINE=/Library/TeX/texbin/pdflatex

# ── MCP apply loop ───────────────────────────────────────────────────────────
# The apply session lives inside the Next process; the MCP server is a separate
# process with no session cookie, so app/api/apply/agent authenticates with this
# shared secret (same pattern as CRON_SECRET). Unset = the route 404s and the
# apply_* MCP tools stay disabled. Any random string works.
DAYSPRING_AGENT_SECRET=
# Where the MCP server reaches the running app (default http://localhost:3000).
# DAYSPRING_APP_URL=http://localhost:3000
